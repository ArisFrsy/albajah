// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model LoginCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Paket {
  idPaket   Int       @id @default(autoincrement())
  nama      String
  pathFoto  String?
  deskripsi String?

  subpakets Subpaket[]
}

model Subpaket {
  idSubpaket   String      @id @default(uuid())
  idPaket      Int
  namaSubPaket String
  hargaIDR     Decimal
  hargaUSD     Decimal
  keberangkatan DateTime
  durasiHari   Int
  penerbangan  String
  hotelMekkah  String
  hotelMadinah String
  fasilitas    String?
  perlengkapan String?

  paket Paket @relation(fields: [idPaket], references: [idPaket])
}

model Berita {
  idBerita  Int     @id @default(autoincrement())
  judul     String
  deskripsi String?
}

model Region {
  idProvinsi   Int
  idKabupaten  Int
  namaProvinsi String
  namaKabupaten String

  // composite primary key
  @@id([idProvinsi, idKabupaten])

  cabangs Cabang[]
}

model Cabang {
  idCabang     Int    @id @default(autoincrement())
  idProvinsi   Int
  idKabupaten  Int
  penanggungjawab String
  email        String
  noTelepon    String

  region Region @relation(fields: [idProvinsi, idKabupaten], references: [idProvinsi, idKabupaten])
}
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Berita {
  idBerita  Int     @id @default(autoincrement())
  judul     String
  deskripsi String?
  imagePath String? @db.VarChar
}

model Cabang {
  idCabang        Int       @unique(map: "cabang_unique") @default(autoincrement())
  idProvinsi      String    @db.VarChar
  idKabupaten     String    @db.VarChar
  penanggungjawab String
  email           String
  noTelepon       String
  provinces       provinces @relation(fields: [idProvinsi], references: [id], map: "cabang_provinces_fk")
  regencies       regencies @relation(fields: [idKabupaten], references: [id], map: "cabang_regencies_fk")
}

model LoginCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Paket {
  idPaket   Int        @id @default(autoincrement())
  nama      String
  deskripsi String?
  pathFoto  String?
  Subpaket  Subpaket[]
}

model Region {
  idProvinsi    Int
  idKabupaten   Int
  namaProvinsi  String
  namaKabupaten String

  @@id([idProvinsi, idKabupaten])
}

model Subpaket {
  idSubpaket    String   @id @default(uuid())
  idPaket       Int
  namaSubPaket  String
  hargaIDR      Decimal
  hargaUSD      Decimal
  keberangkatan DateTime
  durasiHari    Int
  penerbangan   String
  hotelMekkah   String
  hotelMadinah  String
  fasilitas     String?
  perlengkapan  String?
  Paket         Paket    @relation(fields: [idPaket], references: [idPaket])
}

model districts {
  id         String     @id @db.Char(7)
  regency_id String     @db.Char(4)
  name       String     @db.VarChar(50)
  regencies  regencies  @relation(fields: [regency_id], references: [id], map: "districts_regency_id_foreign")
  villages   villages[]
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model provinces {
  id        String      @id @db.Char(2)
  name      String      @db.VarChar(255)
  Cabang    Cabang[]
  regencies regencies[]
}

model regencies {
  id          String      @id @db.Char(4)
  province_id String      @db.Char(2)
  name        String      @db.VarChar(50)
  Cabang      Cabang[]
  districts   districts[]
  provinces   provinces   @relation(fields: [province_id], references: [id], map: "regencies_province_id_foreign")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model villages {
  id          String    @id @db.Char(10)
  district_id String    @db.Char(7)
  name        String    @db.VarChar(50)
  districts   districts @relation(fields: [district_id], references: [id], map: "villages_district_id_foreign")
}

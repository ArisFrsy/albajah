generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Berita {
  idBerita  Int     @id @default(autoincrement())
  judul     String
  deskripsi String?
  imagePath String?
}

model Cabang {
  idCabang        Int       @id @default(autoincrement())
  idProvinsi      String
  idKabupaten     String
  penanggungjawab String
  email           String
  noTelepon       String

  provinces provinces @relation(fields: [idProvinsi], references: [id])
  regencies regencies @relation(fields: [idKabupaten], references: [id])
}

model LoginCode {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Paket {
  idPaket   Int        @id @default(autoincrement())
  nama      String
  deskripsi String?
  pathFoto  String?
  Subpaket  Subpaket[]
}

model Region {
  idProvinsi    Int
  idKabupaten   Int
  namaProvinsi  String
  namaKabupaten String

  @@id([idProvinsi, idKabupaten])
}

model Subpaket {
  idSubpaket    String   @id @default(uuid()) @db.Char(36)
  idPaket       Int
  namaSubPaket  String
  hargaIDR      Decimal
  hargaUSD      Decimal
  keberangkatan DateTime
  durasiHari    Int
  penerbangan   String
  hotelMekkah   String
  hotelMadinah  String
  fasilitas     String?
  perlengkapan  String?

  Paket Paket @relation(fields: [idPaket], references: [idPaket])
}

model districts {
  id         String     @id @db.Char(7)
  regency_id String     @db.Char(4)
  name       String

  regencies  regencies  @relation(fields: [regency_id], references: [id])
  villages   villages[]
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String
  batch     Int
}

model provinces {
  id        String      @id @db.Char(2)
  name      String
  Cabang    Cabang[]
  regencies regencies[]
}

model regencies {
  id          String      @id @db.Char(4)
  province_id String      @db.Char(2)
  name        String

  Cabang      Cabang[]
  districts   districts[]
  provinces   provinces   @relation(fields: [province_id], references: [id])
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model villages {
  id          String    @id @db.Char(10)
  district_id String    @db.Char(7)
  name        String

  districts   districts @relation(fields: [district_id], references: [id])
}
